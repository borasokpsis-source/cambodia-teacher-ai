# Server-only OpenAI settings. Copy this file to .env.local and add your own key.
# Never prefix the OpenAI key with VITE_ because Vite exposes VITE_ variables to browsers.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=12000

# Server-only Anthropic settings for Claude Opus 5.
# Never prefix the Anthropic key with VITE_ because Vite exposes VITE_ variables to browsers.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
ANTHROPIC_GENERATION_TIMEOUT_MS=300000
ANTHROPIC_STRUCTURED_OUTPUTS=true

# Optional legacy Gemini browser key for local personal testing.
# A production deployment should also move Gemini calls behind a server endpoint.
VITE_GEMINI_API_KEY=
